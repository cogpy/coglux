# cogpy/coglux — Standardized Git Attributes (KSM-13)
# NOTE: This repo is 6GB. Consider migrating large assets to LFS.
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.gguf filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.py linguist-language=Python
*.scm linguist-language=Scheme
* text=auto
*.sh text eol=lf
*.c text
*.h text
*.cpp text
*.hpp text
*.png binary
*.jpg binary
*.pdf binary
*.bin binary
